# Application
APP_NAME=Palm Mind RAG
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL. The driver must be asyncpg because the app uses SQLAlchemy asyncio.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# Redis conversation memory
REDIS_URL=redis://localhost:6379/0

# Qdrant vector storage
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# OpenAI-compatible chat completions provider.
# Leave LLM_BASE_URL empty to use the official OpenAI API.
# Set LLM_BASE_URL to point at another compatible provider.
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2

# Embeddings. The vector size is read from this model at runtime.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ingestion and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=5
MAX_UPLOAD_BYTES=10485760
MAX_CONVERSATION_MESSAGES=20
CONVERSATION_TTL_SECONDS=604800
